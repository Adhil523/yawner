.venv/
__pycache__/
.pytest_cache/
.DS_Store

# Source videos stay local: large, and never modified by any script.
assets/raw/

# Everything generated by the analysis pipeline, except the manifest (tiny, tracked so the Pi gets it with
# the code). build/clips/ stays local: copy it to the Pi by hand (README, "Run on the Raspberry Pi").
build/*
!build/manifest.json

# Simulated preview video (regenerated by the pipeline, ~45 MB).
assets/preview/
